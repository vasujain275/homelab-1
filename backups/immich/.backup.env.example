# ── Backblaze B2 credentials (S3-compatible API) ──
# Create in B2 web UI: App Keys > Add a New Application Key
# Bucket: immich-backup (or your bucket name)
# Type: S3 Compatible (not master key)
AWS_ACCESS_KEY_ID=your_b2_key_id_here
AWS_SECRET_ACCESS_KEY=your_b2_application_key_here

# ── Restic repository password ──
# Generate with: openssl rand -base64 32
# STORE THIS SAFELY. If lost, the backup is unrecoverable.
RESTIC_PASSWORD=your_restic_repo_password_here

# ── Backblaze B2 bucket endpoint ──
# Format: s3:https://s3.<region>.backblazeb2.com/<bucket>/<path>
# Replace <region> with your bucket's region (e.g. us-west-004)
RESTIC_REPOSITORY=s3:https://s3.us-east-005.backblazeb2.com/vj-immich-backup/restic
