[Unit]
Description=Immich daily backup to Backblaze B2 via restic
Documentation=https://github.com/vasu/homelab-1/tree/main/backups/immich
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=vasu
ExecStart=/home/vasu/homelab-1/backups/immich/backup.sh

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp /home/vasu/.cache/restic
ReadOnlyPaths=/home/vasu/services/immich
